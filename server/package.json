{
  "name": "telegram-music-player-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm --prefix ../web install && npm --prefix ../web run build && node -e \"require('fs').cpSync('../web/dist', 'web-dist', { recursive: true })\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "express": "^4.21.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12"
  }
}
